# -*- coding: utf-8 -*-
import pcbnew
#exec(open(r"c:\Users\benoi\source\repos\kicadProjetct\kicadProjects\pythonScript").read())
board = pcbnew.GetBoard()

# Parametres generaux
start_x_A = 167.0  # Position X de depart pour groupe A
start_x_B = 150.0  # Position X de depart pour groupe B
spacing_y_components = 2.0
spacing_y_components_RC = 1.5   # Espacement vertical entre chaque ligne de composants

# Espacements entre les blocs de MCP (changez cette valeur selon votre layout)
spacing_y_mcp = 25.0  # Espacement vertical entre chaque bloc MCP

# Positions Y de depart pour chaque MCP
# Ajustez ces valeurs selon la position de chaque MCP sur votre PCB
mcp_start_y = [
    190.0,   # MCP 20 (A0_20-A7_20 et B0_20-B7_20)
    220.0,   # MCP 21 (A0_21-A7_21 et B0_21-B7_21)
    250.0,   # MCP 22 (A0_22-A7_22 et B0_22-B7_22)
    278.0,   # MCP 23 (A0_23-A7_23 et B0_23-B7_23)
]

# Suffixes des MCP a traiter
mcp_suffixes = ['20', '21', '22', '23']

# Espacements horizontaux pour groupe A (vers la droite)
c1_x_A = 7.0
r2_x_A = 7.0

# Espacements horizontaux pour groupe B (vers la gauche)
c1_x_B = -7.0
r2_x_B = -7.0

# Orientation des composants (en degres)
diode_rotation = 0
resistor_rotation = 0
capacitor_rotation = 0
capacitor_rotation_B = 180  # C1 tourne de 180 degres pour le groupe B

def place_component(comp_name, x, y, rotation, layer=None):
    """Fonction pour placer un composant
    layer: 'bottom' pour placer sur la face arriere, None pour face avant
    """
    footprint = board.FindFootprintByReference(comp_name)
    if footprint:
        # Positionner d'abord
        footprint.SetPosition(pcbnew.VECTOR2I(
            int(x * 1e6),
            int(y * 1e6)
        ))

        current_layer = footprint.GetLayer()

        # Si on veut placer sur la couche bottom, flipper si besoin
        if layer == 'bottom':
            if current_layer == pcbnew.B_Cu:
                layer_name = "B.Cu"
            elif current_layer == pcbnew.F_Cu:
                layer_name = "F.Cu"
            else:
                layer_name = "autre"
            print("  [DEBUG] {} couche actuelle: {}".format(comp_name, layer_name))

            # Toujours flipper si on demande bottom et qu'on est sur top
            if current_layer == pcbnew.F_Cu:
                footprint.Flip(footprint.GetPosition(), False)
                print("  [DEBUG] {} flipped vers bottom".format(comp_name))

        # Si aucune couche n'est fournie, forcer le composant sur la face top (F.Cu)
        if layer is None and current_layer != pcbnew.F_Cu:
            footprint.Flip(footprint.GetPosition(), False)
            print("  [DEBUG] {} force sur F.Cu".format(comp_name))

        footprint.SetOrientationDegrees(rotation)

        layer_info = " (bottom)" if layer == 'bottom' else ""
        print("[OK] {} place a ({:.2f}, {:.2f}){}".format(comp_name, x, y, layer_info))
        return True
    else:
        print("[ERREUR] {} non trouve".format(comp_name))
        return False

# Boucle sur chaque MCP
for mcp_index, mcp_suffix in enumerate(mcp_suffixes):
    print("\n========================================")
    print("=== MCP23017_{} ===".format(mcp_suffix))
    print("========================================")
    
    # Position Y de depart pour ce MCP
    start_y = mcp_start_y[mcp_index]
    
    # Placer les composants A0_XX a A7_XX (cote DROIT du MCP23017)
    print("\n=== Placement groupe A_{} (droite) ===".format(mcp_suffix))
    for i in range(8):
        group_y = start_y + ((7 - i) * (spacing_y_components + spacing_y_components_RC)) -  spacing_y_components_RC  # Inverse: A0 en bas, A7 en haut
        group_name = "A{}_{}".format(i, mcp_suffix)
        
        # Ordre: C1 -> R2 (D1 et R1 places par les autres scripts)
        # C1 sur la couche bottom
        place_component("{}_C1".format(group_name), start_x_A + c1_x_A, group_y, capacitor_rotation)
        # R2 cote A tourne de 180 degres
        place_component("{}_R2".format(group_name), start_x_A + r2_x_A, group_y-spacing_y_components_RC, 180)
    
    # Placer les composants B0_XX a B7_XX (cote GAUCHE du MCP23017)
    print("\n=== Placement groupe B_{} (gauche - symetrie) ===".format(mcp_suffix))
    for i in range(8):
        group_y = start_y + (i * (spacing_y_components + spacing_y_components_RC))
        group_name = "B{}_{}".format(i, mcp_suffix)
        
        # Ordre: C1 -> R2 (D1 et R1 places par les autres scripts)
        # C1 sur la couche bottom
        place_component("{}_C1".format(group_name), start_x_B + c1_x_B, group_y, capacitor_rotation_B)
        place_component("{}_R2".format(group_name), start_x_B + r2_x_B, group_y +spacing_y_components_RC, resistor_rotation)

pcbnew.Refresh()
print("\n========================================")
print("--- Placement termine ---")
print("========================================")