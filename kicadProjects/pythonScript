# -*- coding: utf-8 -*-
import pcbnew
#exec(open(r"c:\Users\benoi\source\repos\kicadProjetct\kicadProjects\pythonScript").read())
board = pcbnew.GetBoard()

# Parametres generaux
start_x_A = 230.0  # Position X de depart pour groupe A
start_x_B = 210.0  # Position X de depart pour groupe B
spacing_y_components = 1.5   # Espacement vertical entre chaque ligne de composants

# Espacements entre les blocs de MCP (changez cette valeur selon votre layout)
spacing_y_mcp = 25.0  # Espacement vertical entre chaque bloc MCP

# Positions Y de depart pour chaque MCP
# Ajustez ces valeurs selon la position de chaque MCP sur votre PCB
mcp_start_y = [
    176.0,   # MCP 20 (A0_20-A7_20 et B0_20-B7_20)
    206.0,   # MCP 21 (A0_21-A7_21 et B0_21-B7_21)
    233.0,   # MCP 22 (A0_22-A7_22 et B0_22-B7_22)
    256.0,   # MCP 23 (A0_23-A7_23 et B0_23-B7_23)
]

# Suffixes des MCP a traiter
mcp_suffixes = ['20', '21', '22', '23']

# Espacements horizontaux pour groupe A (vers la droite)
c1_x_A = 0.0
diode_x_A = 5.0
r1_x_A = 10.0
r2_x_A = 15.0

# Espacements horizontaux pour groupe B (vers la gauche)
c1_x_B = 0.0
diode_x_B = -5.0
r1_x_B = -10.0
r2_x_B = -15.0

# Orientation des composants (en degres)
diode_rotation = 0
resistor_rotation = 0
capacitor_rotation = 0

def place_component(comp_name, x, y, rotation):
    """Fonction pour placer un composant"""
    footprint = board.FindFootprintByReference(comp_name)
    if footprint:
        footprint.SetPosition(pcbnew.VECTOR2I(
            int(x * 1e6),
            int(y * 1e6)
        ))
        footprint.SetOrientationDegrees(rotation)
        print("[OK] {} place a ({:.2f}, {:.2f})".format(comp_name, x, y))
        return True
    else:
        print("[ERREUR] {} non trouve".format(comp_name))
        return False

# Boucle sur chaque MCP
for mcp_index, mcp_suffix in enumerate(mcp_suffixes):
    print("\n========================================")
    print("=== MCP23017_{} ===".format(mcp_suffix))
    print("========================================")
    
    # Position Y de depart pour ce MCP
    start_y = mcp_start_y[mcp_index]
    
    # Placer les composants A0_XX a A7_XX (cote DROIT du MCP23017)
    print("\n=== Placement groupe A_{} (droite) ===".format(mcp_suffix))
    for i in range(8):
        group_y = start_y + (i * spacing_y_components)
        group_name = "A{}_{}".format(i, mcp_suffix)
        
        # Ordre: C1 -> D1 -> R1 -> R2
        place_component("{}_C1".format(group_name), start_x_A + c1_x_A, group_y, capacitor_rotation)
        place_component("{}_D1".format(group_name), start_x_A + diode_x_A, group_y, diode_rotation)
        place_component("{}_R1".format(group_name), start_x_A + r1_x_A, group_y, resistor_rotation)
        place_component("{}_R2".format(group_name), start_x_A + r2_x_A, group_y, resistor_rotation)
    
    # Placer les composants B0_XX a B7_XX (cote GAUCHE du MCP23017)
    print("\n=== Placement groupe B_{} (gauche - symetrie) ===".format(mcp_suffix))
    for i in range(8):
        group_y = start_y + (i * spacing_y_components)
        group_name = "B{}_{}".format(i, mcp_suffix)
        
        # Ordre: C1 -> D1 -> R1 -> R2 (symetrie)
        place_component("{}_C1".format(group_name), start_x_B + c1_x_B, group_y, capacitor_rotation)
        place_component("{}_D1".format(group_name), start_x_B + diode_x_B, group_y, diode_rotation)
        place_component("{}_R1".format(group_name), start_x_B + r1_x_B, group_y, resistor_rotation)
        place_component("{}_R2".format(group_name), start_x_B + r2_x_B, group_y, resistor_rotation)

pcbnew.Refresh()
print("\n========================================")
print("--- Placement termine ---")
print("========================================")