# -*- coding: utf-8 -*-
import pcbnew
#exec(open(r"c:\Users\benoi\source\repos\kicadProjetct\kicadProjects\pythonScript_grid").read())
board = pcbnew.GetBoard()

# ============================================
# PARAMETRES PLACEMENT BOUTONS EN GRILLE
# ============================================

# Espacement standard Cherry MX (0.75 inch = 19.05 mm)
SWITCH_SPACING = 19.05

# Position de depart (A6_22 en bas a gauche)
START_X = 210.0  # A ajuster selon votre PCB
START_Y = 230.0  # A ajuster selon votre PCB

# Configuration: 3 rangees de 6 boutons
NUM_COLUMNS = 3  # 3 rangees (22, 23, 24)
NUM_ROWS = 6     # 6 boutons par rangee

# MCP suffixes pour les 3 rangees
# La numerotation continue entre les MCPs
# Rangee 1: A6_22, B6_22, A7_22, B7_22, A0_23, B0_23
# Rangee 2: A1_23, B1_23, A2_23, B2_23, A3_23, B3_23
# Rangee 3: A4_23, B4_23, A5_23, B5_23, A6_23, B6_23

# Nommage des boutons dans chaque rangee (de bas en haut)
BUTTON_NAMES_IN_COLUMNS = [
    # Rangee 1 (gauche)
    [('A', 6, '22'), ('B', 6, '22'), ('A', 7, '22'), ('B', 7, '22'), ('A', 0, '23'), ('B', 0, '23')],
    # Rangee 2 (milieu)
    [('A', 1, '23'), ('B', 1, '23'), ('A', 2, '23'), ('B', 2, '23'), ('A', 3, '23'), ('B', 3, '23')],
    # Rangee 3 (droite)
    [('A', 4, '23'), ('B', 4, '23'), ('A', 5, '23'), ('B', 5, '23'), ('A', 6, '23'), ('B', 6, '23')],
]

# Rotation des switches (en degres)
SWITCH_ROTATION = 0

# Liste des boutons a placer
BUTTONS = []

# Construire la liste des boutons
for col_index, column_buttons in enumerate(BUTTON_NAMES_IN_COLUMNS):
    for row_index, (port, pin, mcp) in enumerate(column_buttons):
        button_name = "{}{}_{}".format(port, pin, mcp)
        
        # Position: colonne de gauche a droite, ligne de bas en haut
        x_offset = col_index  # Colonne
        y_offset = -(NUM_ROWS - 1 - row_index)  # Ligne (negatif car Y augmente vers le bas)
        
        BUTTONS.append((button_name, x_offset, y_offset))

# ============================================
# FONCTIONS
# ============================================

def place_component(comp_name, x, y, rotation):
    """Place un composant aux coordonnees specifiees"""
    footprint = board.FindFootprintByReference(comp_name)
    if footprint:
        footprint.SetPosition(pcbnew.VECTOR2I(
            int(x * 1e6),  # Conversion mm -> nm
            int(y * 1e6)
        ))
        footprint.SetOrientationDegrees(rotation)
        print("  [OK] {} -> ({:.2f}, {:.2f})".format(comp_name, x, y))
        return True
    else:
        print("  [WARN] {} non trouve".format(comp_name))
        return False

# ============================================
# PLACEMENT PRINCIPAL
# ============================================

print("=" * 60)
print("PLACEMENT BOUTONS EN GRILLE 3x6")
print("Espacement: {} mm (0.75 inch)".format(SWITCH_SPACING))
print("Total de boutons: {}".format(len(BUTTONS)))
print("=" * 60)

total_placed = 0
total_missing = 0

for button_name, x_offset, y_offset in BUTTONS:
    x_pos = START_X + (x_offset * SWITCH_SPACING)
    y_pos = START_Y + (y_offset * SWITCH_SPACING)
    
    if place_component(button_name, x_pos, y_pos, SWITCH_ROTATION):
        total_placed += 1
    else:
        total_missing += 1

# Rafraichir l'affichage
pcbnew.Refresh()

print("\n" + "=" * 60)
print("PLACEMENT TERMINE")
print("Boutons places: {}".format(total_placed))
print("Boutons non trouves: {}".format(total_missing))
print("=" * 60)
