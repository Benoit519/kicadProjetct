# -*- coding: utf-8 -*-
import pcbnew
#exec(open(r"c:\Users\benoi\source\repos\kicadProjetct\kicadProjects\pythonScript_switches").read())
board = pcbnew.GetBoard()

# ============================================
# PARAMETRES PLACEMENT BOUTONS CHERRY MX
# Disposition en DIAGONALE
# ============================================

# Espacement standard Cherry MX (0.75 inch = 19.05 mm)
SWITCH_SPACING = 19.05

# Pour la diagonale (lignes decalees):
# - Deplacement horizontal entre 2 boutons: 19.05 mm
# - Deplacement vertical entre 2 boutons: 19.05/2 = 9.525 mm
# Triangle rectangle: base 19.05mm, hauteur 9.525mm
DIAG_STEP_X = SWITCH_SPACING       # 19.05 mm
DIAG_STEP_Y = SWITCH_SPACING / 2.0  # 9.525 mm

# Position de depart (A0_20 en haut a gauche)
START_X = 46.0
START_Y = 94.0

# Parametres pour les composants additionnels (D1, R1, Via)
# Position relative au centre du bouton
COMPONENT_OFFSET_X = -SWITCH_SPACING / 2.0  # A gauche du bouton (entre 2 rangees)
VIA_OFFSET_X = 3.0                          # 3mm à droite du centre
VIA_OFFSET_Y = -10.0                        # 10mm au-dessus du centre
DIODE_OFFSET_Y = 0.0                        # Au milieu du bouton (axe Y)
RESISTOR_OFFSET_Y = SWITCH_SPACING / 2.0    # En bas du bouton

# Parametres du via
VIA_SIZE = 0.8        # Diametre du via en mm
VIA_DRILL = 0.4       # Diametre du percage en mm
VIA_NET_NAME = "GND"  # Nom du net (plan de masse)

# Rotation des composants
DIODE_ROTATION = 90   # Diode verticale
RESISTOR_ROTATION = -90  # Resistance verticale

# Total de 44 boutons selon la disposition en diagonale
# En comptant depuis le haut: 2, 3, 4, 4, 4, 4, 4, 4, 4, 4, 4, 3 boutons par diagonale
# Total = 12 diagonales

# Liste des boutons a placer
BUTTONS = []

# Position de la premiere diagonale (point de depart)
current_diag_start_x = 0
current_diag_start_y = 0

# ==========================================
# DIAGONALE 0: 2 boutons (A0_20, B0_20)
# ==========================================
diag_buttons = ["A0_20", "A1_20"]
for i, btn in enumerate(diag_buttons):
    x = current_diag_start_x + i
    y = current_diag_start_y - i
    BUTTONS.append((btn, x, y))

# Passer a la diagonale suivante (descendre d'une case)
current_diag_start_x = 0
current_diag_start_y = 2  # Increment de 2 pour maintenir 19.05mm vertical

# ==========================================
# DIAGONALE 1: 3 boutons (A2_20, A3_20, A4_20)
# ==========================================
diag_buttons = ["A2_20", "A3_20", "A4_20"]
for i, btn in enumerate(diag_buttons):
    x = current_diag_start_x + i
    y = current_diag_start_y - i
    BUTTONS.append((btn, x, y))

# Passer a la diagonale suivante (descendre d'une case)
current_diag_start_x = 0
current_diag_start_y = 4  # Increment de 2 pour maintenir 19.05mm vertical

# ==========================================
# DIAGONALES 2 a 10: 9 diagonales de 4 boutons
# ==========================================
# Liste des boutons pour ces diagonales
buttons_4_diag = [
    ["A5_20", "A6_20", "A7_20", "B0_20"],  # Diag 2
    ["B1_20", "B2_20", "B3_20", "B4_20"],  # Diag 3
    ["B5_20", "B6_20", "B7_20", "A0_21"],  # Diag 4
    ["A1_21", "A2_21", "A3_21", "A4_21"],  # Diag 5
    ["A5_21", "A6_21", "A7_21", "B0_21"],  # Diag 6
    ["B1_21", "B2_21", "B3_21", "B4_21"],  # Diag 7
    ["B5_21", "B6_21", "B7_21", "A0_22"],  # Diag 8
    ["A1_22", "A2_22", "A3_22", "A4_22"],  # Diag 9
    ["A5_22", "A6_22", "A7_22", "B0_22"],  # Diag 10
]

for diag_buttons in buttons_4_diag:
    # Placer les 4 boutons de cette diagonale
    for i, btn in enumerate(diag_buttons):
        x = current_diag_start_x + i
        y = current_diag_start_y - i
        BUTTONS.append((btn, x, y))
    
    # Passer a la diagonale suivante (increment de 2 pour 19.05mm vertical)
    current_diag_start_y += 2

# ==========================================
# DIAGONALE 11 (derniere): 3 boutons (B4_22, A5_22, B5_22)
# Commence plus haut (ajustement -1)
# ==========================================
diag_buttons = ["B1_22", "B2_22", "B3_22"]
for i, btn in enumerate(diag_buttons):
    x = 1 + i  # Commence a la seconde colonne (x=1)
    y = (current_diag_start_y - 1) - i  # Remonte d'une unite
    BUTTONS.append((btn, x, y))

# Rotation des switches (en degres)
SWITCH_ROTATION = 0

# ============================================
# FONCTIONS
# ============================================

def place_component(comp_name, x, y, rotation):
    """Place un composant aux coordonnees specifiees"""
    footprint = board.FindFootprintByReference(comp_name)
    if footprint:
        footprint.SetPosition(pcbnew.VECTOR2I(
            int(x * 1e6),  # Conversion mm -> nm
            int(y * 1e6)
        ))
        footprint.SetOrientationDegrees(rotation)
        print("  [OK] {} -> ({:.2f}, {:.2f})".format(comp_name, x, y))
        return True
    else:
        print("  [WARN] {} non trouve".format(comp_name))
        return False

def place_via(x, y, size, drill, net_name):
    """Place un via aux coordonnees specifiees"""
    try:
        via = pcbnew.PCB_VIA(board)
        via.SetPosition(pcbnew.VECTOR2I(int(x * 1e6), int(y * 1e6)))
        via.SetWidth(int(size * 1e6))
        via.SetDrill(int(drill * 1e6))
        
        # Connecter au net GND
        netinfo = board.FindNet(net_name)
        if netinfo:
            via.SetNet(netinfo)
        
        board.Add(via)
        print("  [OK] Via place a ({:.2f}, {:.2f})".format(x, y))
        return True
    except Exception as e:
        print("  [ERREUR] Via: {}".format(str(e)))
        return False

def remove_existing_vias():
    """Supprime tous les vias existants du PCB"""
    vias_removed = 0
    
    # Methode plus robuste pour supprimer les vias
    while True:
        tracks = list(board.GetTracks())
        via_found = False
        
        for track in tracks:
            if track.GetClass() == 'PCB_VIA':
                board.Remove(track)
                vias_removed += 1
                via_found = True
                break  # Recommencer la recherche apres suppression
        
        if not via_found:
            break  # Plus de vias a supprimer
    
    print("  [INFO] {} vias supprimes".format(vias_removed))
    pcbnew.Refresh()
    return vias_removed

# ============================================
# PLACEMENT PRINCIPAL
# ============================================

print("=" * 60)
print("PLACEMENT BOUTONS CHERRY MX EN DIAGONALE")
print("Espacement: {} mm (0.75 inch)".format(SWITCH_SPACING))
print("Total de boutons: {}".format(len(BUTTONS)))
print("=" * 60)

# Supprimer les vias existants
print("\n### SUPPRESSION DES VIAS EXISTANTS ###\n")
vias_removed = remove_existing_vias()
pcbnew.Refresh()

total_placed = 0
total_missing = 0
total_vias = 0

# ETAPE 1: Placer les boutons et leurs vias
print("\n### ETAPE 1: PLACEMENT DES BOUTONS ET VIAS ###\n")

button_counter = 0
for button_name, x_offset, y_offset in BUTTONS:
    button_counter += 1
    x_pos = START_X + (x_offset * DIAG_STEP_X)
    y_pos = START_Y + (y_offset * DIAG_STEP_Y)
    
    print("[{}] Traitement: {}".format(button_counter, button_name))
    
    # Placer le bouton
    if place_component(button_name, x_pos, y_pos, SWITCH_ROTATION):
        total_placed += 1
        
        # Placer UN SEUL via: 0mm (centre horizontal) et 4mm au-dessus du centre
        via_x = x_pos + 0.0   # Centre horizontal (1-1)
        via_y = y_pos - 4.0   # 4mm au-dessus (8-4)
        print("  => Creation via unique a ({:.2f}, {:.2f})".format(via_x, via_y))
        if place_via(via_x, via_y, VIA_SIZE, VIA_DRILL, VIA_NET_NAME):
            total_vias += 1
        print("  => Total vias crees jusqu'ici: {}".format(total_vias))
    else:
        total_missing += 1

# Rafraichir l'affichage
pcbnew.Refresh()

print("\n" + "=" * 60)
print("ETAPE 1 TERMINEE")
print("Boutons places: {}".format(total_placed))
print("Vias places: {}".format(total_vias))
print("Boutons non trouves: {}".format(total_missing))
print("=" * 60)

# ETAPE 2: Placer les diodes D1
print("\n### ETAPE 2: PLACEMENT DES DIODES D1 ###\n")

total_diodes = 0
diode_missing = 0

for button_name, x_offset, y_offset in BUTTONS:
    x_pos = START_X + (x_offset * DIAG_STEP_X)
    y_pos = START_Y + (y_offset * DIAG_STEP_Y)
    
    # Position de la diode: 13mm à gauche et 2mm en dessous du centre
    diode_x = x_pos - 13.0  # 13mm à gauche
    diode_y = y_pos + 2.0   # 2mm plus bas
    
    # Nom de la diode
    diode_name = "{}_D1".format(button_name)
    
    if place_component(diode_name, diode_x, diode_y, DIODE_ROTATION):
        total_diodes += 1
    else:
        diode_missing += 1

pcbnew.Refresh()

print("\n" + "=" * 60)
print("ETAPE 2 TERMINEE")
print("Diodes placees: {}".format(total_diodes))
print("Diodes non trouvees: {}".format(diode_missing))
print("=" * 60)

# ETAPE 3: Placer les resistances R1
print("\n### ETAPE 3: PLACEMENT DES RESISTANCES R1 ###\n")

total_resistors = 0
resistor_missing = 0

for button_name, x_offset, y_offset in BUTTONS:
    x_pos = START_X + (x_offset * DIAG_STEP_X)
    y_pos = START_Y + (y_offset * DIAG_STEP_Y)
    
    # Position de la resistance: meme X que D1, 4mm au-dessus de D1
    resistor_x = x_pos - 13.0  # Meme X que D1 (13mm à gauche)
    resistor_y = y_pos - 2.0   # 4mm au-dessus de D1 (2-4=-2)
    
    # Nom de la resistance
    resistor_name = "{}_R1".format(button_name)
    
    if place_component(resistor_name, resistor_x, resistor_y, RESISTOR_ROTATION):
        total_resistors += 1
    else:
        resistor_missing += 1

pcbnew.Refresh()

print("\n" + "=" * 60)
print("ETAPE 3 TERMINEE")
print("Resistances placees: {}".format(total_resistors))
print("Resistances non trouvees: {}".format(resistor_missing))
print("=" * 60)
